# ── FB Marketplace Poster Service (Headless) ──
# Runs Playwright + Chromium headless on Railway.

FROM mcr.microsoft.com/playwright:v1.50.0-noble

WORKDIR /app

# Cache bust: v5
RUN echo "bust cache v5"

# Copy only what the poster needs
COPY package-poster.json ./package.json
COPY scripts/ ./scripts/

# Install poster dependencies
RUN npm install

# Create session directories for multi-user
RUN mkdir -p /app/.fb-sessions /app/.fb-session

# Set Railway indicator env var
ENV RAILWAY_HEADLESS=true

# Expose the health check port
EXPOSE 3000

# Default: run via Railway starter (starts health check first, then poster)
CMD ["node", "scripts/railway-start.mjs"]
