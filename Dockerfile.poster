# ── FB Marketplace Suite (Poster + Auto-Reply + Renewer) ──
# Uses slim Node image + only Chromium (not the full Playwright image)

FROM node:20-slim

# Install only Chromium dependencies (not full browsers)
RUN apt-get update && apt-get install -y \
    chromium \
    fonts-liberation \
    libnss3 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libxkbcommon0 \
    libgbm1 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Tell Playwright to use system Chromium instead of downloading its own
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

WORKDIR /app

# Copy and install
COPY package-poster.json ./package.json
COPY scripts/ ./scripts/
RUN npm install

# Create session directories
RUN mkdir -p /app/.fb-sessions /app/.fb-session

# Railway env
ENV RAILWAY_HEADLESS=true
EXPOSE 3000

# Use orchestrator that runs all three services
CMD ["node", "scripts/railway-start.mjs"]
