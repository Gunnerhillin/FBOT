# ── FB Marketplace Suite (Poster + Auto-Reply + Renewer) ──
# Uses Playwright's own Chromium for full compatibility with modern sites

FROM node:20-slim

# Install dependencies that Playwright's Chromium needs
RUN apt-get update && apt-get install -y \
    fonts-liberation \
    libnss3 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libxkbcommon0 \
    libgbm1 \
    libasound2 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libpango-1.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libatspi2.0-0 \
    libxshmfence1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy and install deps first (better layer caching)
COPY package-poster.json ./package.json
RUN npm install

# Let Playwright download its own patched Chromium
RUN npx playwright install chromium

# Copy scripts
COPY scripts/ ./scripts/

# Create session directories
RUN mkdir -p /app/.fb-sessions /app/.fb-session

# Railway env
ENV RAILWAY_HEADLESS=true
EXPOSE 3000

# Use orchestrator that runs all three services
CMD ["node", "scripts/railway-start.mjs"]
